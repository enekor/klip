<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Klip" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Transparent, no animation: the capture activities must be imperceptible. -->
    <style name="Theme.Klip.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
