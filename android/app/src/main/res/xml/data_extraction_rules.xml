<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred: pair secrets are encrypted with a device-bound Keystore key,
  so a copied config would be unreadable on another device. Pair again instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
