<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Allows building on Linux (CI / dev container). Running requires Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Klip</AssemblyName>
    <RootNamespace>Klip.Windows</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Klip</Product>
    <Description>Sincronizador local de portapapeles</Description>
    <ApplicationIcon>klip.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="klip.ico" LogicalName="klip.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core-dotnet\Klip.Node\Klip.Node.csproj" />
  </ItemGroup>

</Project>
