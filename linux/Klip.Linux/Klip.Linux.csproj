<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>klip</AssemblyName>
    <RootNamespace>Klip.Linux</RootNamespace>
    <Version>1.1.0</Version>
    <Product>Klip</Product>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Ship our own ICU: the NFC normalization of the protocol must not depend on the distro's libicu version. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Klip.Linux.Platform\Klip.Linux.Platform.csproj" />
  </ItemGroup>

</Project>
